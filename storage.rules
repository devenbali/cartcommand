rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // VIN tag photos — authenticated users can read/write
    match /vin-photos/{cartId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // 10MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // Scrap defect photos — authenticated users can read/write
    match /scrap-photos/{entryId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024  // 10MB max
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
